{
  "manifest_version": 3,
  "name": "Moodle AI Reviewer",
  "version": "1.5.5",
  "description": "Findet in Moodles Manueller Bewertung alle frei eingetippten Antworten (Cloze-Lücken, Kurzantwort, Numerisch), die nicht erkannt wurden, trägt von einer KI berechnete Punkte ein und schreibt Feedback zu schwachen Antworten.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*mod/quiz/report.php*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
