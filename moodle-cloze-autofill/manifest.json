{
  "manifest_version": 3,
  "name": "Moodle Cloze Autofill",
  "version": "2.0.3",
  "description": "Traegt neue Antwortvarianten in die Cloze-Luecken der Fragensammlung ein: erzeugt einen Prompt aus den vorhandenen Luecken und setzt das von der KI gelieferte JSON chirurgisch in die Fragen ein.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*question/edit.php*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://*/*question/edit.php*"
      ]
    }
  ]
}
